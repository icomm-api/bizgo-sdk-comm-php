{
    "name": "icomm-api/bizgo-sdk-comm",
    "description": "PHP SDK for the Bizgo Communication API: SMS/LMS/MMS, international SMS, RCS, Kakao AlimTalk/BrandMessage, Naver TalkTalk.",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": ["bizgo", "infobank", "sms", "lms", "mms", "rcs", "kakao", "alimtalk", "brandmessage", "navertalk", "sdk"],
    "homepage": "https://github.com/icomm-api/bizgo-sdk-comm-php",
    "authors": [
        {
            "name": "Infobank",
            "homepage": "https://bizgo.io"
        }
    ],
    "support": {
        "issues": "https://github.com/icomm-api/bizgo-sdk-comm-php/issues",
        "source": "https://github.com/icomm-api/bizgo-sdk-comm-php",
        "docs": "https://developers.bizgo.io/api-sdk/api-reference",
        "security": "https://github.com/icomm-api/bizgo-sdk-comm-php/security/policy"
    },
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^2.0 || ^3.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.9",
        "nyholm/psr7": "^1.8",
        "open-telemetry/api": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^3.13 || ^4.0",
        "symfony/http-client": "^7.3",
        "symfony/yaml": "^7.3"
    },
    "suggest": {
        "psr/http-client-implementation": "To send requests through your own PSR-18 client (proxies, custom TLS) instead of the built-in cURL transport",
        "open-telemetry/api": "For tracing with Bizgo\\Observability\\OpenTelemetryHook (one span per API call); the SDK works without it"
    },
    "autoload": {
        "psr-4": {
            "Bizgo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bizgo\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": false,
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true,
        "secure-http": true,
        "audit": {
            "abandoned": "fail"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --no-progress",
        "cs": "phpcs",
        "cs-fix": "phpcbf",
        "generate": "@php bin/generate-models.php",
        "generate-check": "@php bin/generate-models.php --check",
        "check": [
            "@composer validate --strict",
            "@generate-check",
            "@cs",
            "@stan",
            "@test"
        ]
    }
}
